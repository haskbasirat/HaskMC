# A whitelist of files that should be included into Docker.
# Put an exclaimation mark before everything to include.

# Ignore everything
*

# Allow the source code folders
!/crates/
!/tools/
!/assets/
!/haskmc.toml
!/pumpkin.toml
!/LICENSE
!/FORK_NOTICE.md
!/THIRD_PARTY_NOTICES.md

# Allow build.rs to read git commit sha
!/.git

# Dependencies
!Cargo.lock
!Cargo.toml
